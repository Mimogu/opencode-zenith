{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b",
  "small_model": "nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b",
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -fr *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -r *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push -f*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git clean -f*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git checkout -- *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "dd *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "mkfs*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "chmod -R *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "chown -R *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "systemctl stop *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "systemctl disable *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "pacman -R*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "yay -R*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "pkill *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "killall *",
      "effect": "ask"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "task",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "doom_loop",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "lsp",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "kill *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "xargs kill*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "xargs -r kill*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "pkill*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "killall*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "kill -*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*opencode.db*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*opencode.db*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*--break-system-packages*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "sudo pip*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "sudo python* -m pip*",
      "effect": "ask"
    }
  ],
  "update": "notify",
  "websearch": {
    "provider": "exa"
  },
  "compaction": {
    "auto": true,
    "buffer": "20%"
  },
  "mcp": {
    "graphify": {
      "type": "remote",
      "url": "http://127.0.0.1:8081/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "my-browser": {
      "type": "local",
      "command": [
        "{{CONFIG_DIR}}/mcp-servers/node_modules/.bin/playwright-mcp",
        "--cdp-endpoint",
        "http://127.0.0.1:9222"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "my-firefox": {
      "type": "local",
      "command": [
        "bun",
        "run",
        "{{CONFIG_DIR}}/plugins/my-firefox/index.mjs"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "camofox": {
      "type": "local",
      "command": [
        "node",
        "{{CONFIG_DIR}}/mcp-servers/camofox/server.mjs"
      ],
      "environment": {
        "CAMOFOX_URL": "http://127.0.0.1:9377"
      },
      "enabled": true,
      "timeout": 120000
    },
    "memory": {
      "type": "local",
      "command": [
        "python3",
        "{{CONFIG_DIR}}/memory_mcp.py"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "providers": {
    "openrouter": {
      "name": "OpenRouter",
      "package": "@opencode/ai/providers/openrouter",
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "models": {},
      "settings": {
        "chunkTimeout": 45000
      }
    },
    "omniroute": {
      "name": "OmniRoute Gateway",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": [
        "OMNIROUTE_API_KEY"
      ],
      "settings": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "chunkTimeout": 90000
      },
      "models": {
        "omni-code": {
          "name": "OmniRoute Code Authoring Combo (Claude Sonnet 4.6 / Fable 5 - 1M Context)"
        },
        "omni-explore": {
          "name": "OmniRoute Explorer Combo (Nemotron VL / Gemini 3.8 / Agnes - 1M Context)"
        },
        "omni-review": {
          "name": "OmniRoute Verifier & Reviewer Combo (Claude Opus 4.6 Thinking / Fable 5 - 1M Context)"
        },
        "omni-quick": {
          "name": "OmniRoute Ultra-Fast Combo (Gemini 3.5 Flash Lite / Nemotron - 1M Context)"
        },
        "auto/best-coding": {
          "name": "OmniRoute Auto Best Coding (1M Context)"
        },
        "auto/best-reasoning": {
          "name": "OmniRoute Auto Best Reasoning (1M Context)"
        },
        "auto/fast": {
          "name": "OmniRoute Auto Fast (1M Context)"
        },
        "auto/best-fast": {
          "name": "OmniRoute Auto Best Fast (1M Context)"
        },
        "antigravity/claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (8 AGY Pool - 1M Context)"
        },
        "antigravity/claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking (8 AGY Pool - 1M Context)"
        },
        "antigravity/gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite (1M Context)"
        },
        "antigravity/gemini-3.8-flash-tiered": {
          "name": "Gemini 3.8 Flash Tiered (1M Context)"
        },
        "agnes/agnes-3.0-flash": {
          "name": "Agnes 3.0 Flash (524K Context)"
        },
        "openrouter/nvidia/nemotron-3.5-super-vl:free": {
          "name": "Nemotron 3.5 Super VL (OpenRouter Free - 1M Context)"
        },
        "openrouter/nvidia/nemotron-3.5-lightning:free": {
          "name": "Nemotron 3.5 Lightning (OpenRouter Free - 1M Context)"
        },
        "openrouter/google/gemma-4-31b-it:free": {
          "name": "Google Gemma 4 31B (OpenRouter Free - 262K Context)"
        },
        "omni-image": {
          "name": "OmniRoute Image Generation Combo"
        },
        "agy/claude-sonnet-4-6": {
          "name": "agy/claude-sonnet-4-6 (vision, auto-added by see --calibrate)"
        },
        "cloudflare-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast": {
          "name": "Cloudflare Workers AI \u00b7 Llama 3.3 70B (free daily)"
        },
        "cloudflare-ai/@cf/qwen/qwen2.5-coder-32b-instruct": {
          "name": "Cloudflare Workers AI \u00b7 Qwen 2.5 Coder 32B (free daily)"
        },
        "cloudflare-ai/@cf/zai-org/glm-4.7-flash": {
          "name": "Cloudflare Workers AI \u00b7 GLM 4.7 Flash (free daily)"
        },
        "sambanova/gpt-oss-120b": {
          "name": "SambaNova \u00b7 GPT-OSS 120B (free tier)"
        },
        "sambanova/Meta-Llama-3.3-70B-Instruct": {
          "name": "SambaNova \u00b7 Llama 3.3 70B (free tier)"
        },
        "sambanova/MiniMax-M3.1-Flash": {
          "name": "SambaNova \u00b7 MiniMax M3.1 Flash (free tier)"
        }
      }
    },
    "nvidia": {
      "name": "NVIDIA NIM",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": [
        "NVIDIA_API_KEY"
      ],
      "settings": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "chunkTimeout": 45000
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra 550B (NVIDIA NIM free)"
        },
        "nvidia/nemotron-3.5-super-vl-120b-a12b": {
          "name": "Nemotron 3.5 Super VL 120B (NVIDIA NIM free)",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        },
        "nvidia/nemotron-3.5-lightning-30b-a3b": {
          "name": "Nemotron 3.5 Lightning 30B (NVIDIA NIM free)"
        },
        "stepfun-ai/step-5-preview": {
          "name": "Step 5 Preview (NVIDIA NIM free)"
        },
        "poolside/laguna-xs-2.1": {
          "name": "Poolside Laguna XS 2.1 (NVIDIA NIM free)"
        }
      }
    }
  },
  "instructions": [
    "CLAUDE.md"
  ]
}