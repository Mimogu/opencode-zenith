# ==============================================================================
# OpenCode Zenith - Environment Configuration Template
# ==============================================================================
# Copy this file to free-models.env inside your OpenCode configuration directory:
#   Linux:   ~/.config/opencode/free-models.env
#   Windows: %USERPROFILE%\.config\opencode\free-models.env
#
# All providers below are optional, but adding free keys unlocks the multi-tier
# automated failover ladders and daily benchmarking capabilities.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Free AI Providers
# ------------------------------------------------------------------------------

# OpenRouter (Recommended - free models like Gemini Flash, Llama 3.3, Nemotron)
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# NVIDIA NIM (Free developer allowance for Nemotron 3.5 Super VL, Ultra 550B)
# Get your free key at: https://build.nvidia.com
NVIDIA_API_KEY=

# OmniRoute Local Gateway API Key (Created in your local dashboard on :20128)
# Dashboard URL: http://localhost:20128
OMNIROUTE_API_KEY=

# ------------------------------------------------------------------------------
# 2. Secondary Fast / Free Standby Providers (Optional)
# ------------------------------------------------------------------------------

# Groq Cloud (Ultra-fast inference for open models)
# https://console.groq.com/keys
GROQ_API_KEY=

# SambaNova Cloud (High-speed open models)
# https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# Hugging Face User Access Token (Free open weights)
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Cloudflare Workers AI (Free daily allowance)
# https://dash.cloudflare.com/
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Fal.ai (Media and image generation)
# https://fal.ai/dashboard/keys
FAL_KEY=

# ------------------------------------------------------------------------------
# 3. OpenCode Zenith Performance & Pruning Defaults
# ------------------------------------------------------------------------------
# In Manual Mode, the skill router and playbooks stay dormant until requested,
# saving maximum context budget for free and low-context models (8k-32k).
OPENCODE_NO_SKILL_ROUTER=1
OPENCODE_NO_PLAYBOOKS=1

# Context window pruning optimizations for free models
OPENCODE_PRUNE_KEEP=6
OPENCODE_PRUNE_CHUNK=6
OPENCODE_SILENT_EVERY=7
