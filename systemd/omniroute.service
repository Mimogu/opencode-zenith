[Unit]
Description=OmniRoute AI proxy router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
TimeoutStartSec=300
ExecStart=/usr/bin/env node %h/.npm-global/lib/node_modules/omniroute/bin/omniroute.mjs serve --no-open
Restart=on-failure
RestartSec=5
Environment="PATH=%h/.npm-global/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%h/.config/opencode/free-models.env

[Install]
WantedBy=default.target
